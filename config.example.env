# config.example.env - Template for local .env setup
# =====================================================
# Copy this file to .env and fill in real values.
# The .env file is gitignored and must never be committed.
#
# These values are injected into resume and cover letter headers at build time.
# If a variable is missing, the build falls back to a safe placeholder.
#
# NEVER put real phone, email, or personal data in this public file.
# Real values belong in .env locally or GitHub Actions Secrets.
#
# Troy contact rules:
# TROY_EMAIL must be TroyHokanson@iCloud.com.
# TROY_PORTFOLIO must be https://TroyHokanson.com and is displayed last,
# immediately after LinkedIn, in every resume and cover-letter header.

TROY_PHONE=612.555.0000
TROY_EMAIL=yourname@example.com
TROY_LOCATION=City, ST
TROY_LINKEDIN=linkedin.com/in/yourprofile
TROY_PORTFOLIO=https://TroyHokanson.com
TROY_NAME=Troy Hokanson
