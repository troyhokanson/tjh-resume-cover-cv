# config.example.env - Template for local .env setup
# =====================================================
# Copy this file to .env and fill in real values.
# The .env file is gitignored and must never be committed.
#
# These values are injected into resume and cover letter headers at build time.
# Blank variables are treated as unset and use the safe defaults in config.py.
#
# NEVER put real phone, email, or other private personal data in this public file.
# Real private values belong in .env locally or GitHub Actions Secrets.
#
# Troy contact rules:
# - TROY_EMAIL must be TroyHokanson@iCloud.com in local .env and GitHub Actions Secrets.
# - TROY_PORTFOLIO must point to the canonical portfolio at https://troyhokanson.com.

TROY_PHONE=612.555.0000
TROY_EMAIL=TroyHokanson@iCloud.com
TROY_LOCATION=Lakeville, MN
TROY_LINKEDIN=linkedin.com/in/troyhokanson
TROY_PORTFOLIO=https://troyhokanson.com
TROY_NAME=Troy Hokanson