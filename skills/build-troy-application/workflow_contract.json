{
  "schema_version": "1.4.0",
  "skill": "build-troy-application",
  "candidate": "Troy J. Hokanson",
  "authoritative_repository": "troyhokanson/tjh-resume-cover-cv",
  "status_values": [
    "researching",
    "drafting",
    "exception",
    "ready_to_submit",
    "submitted",
    "interviewing",
    "offer",
    "rejected",
    "paused",
    "skipped"
  ],
  "phases": [
    {
      "id": "exact_opportunity",
      "required": true,
      "checks": [
        "candidate_confirmed",
        "employer_confirmed",
        "exact_title_confirmed",
        "job_id_recorded_or_exception",
        "official_url_recorded_or_exception",
        "location_recorded",
        "work_mode_recorded",
        "salary_recorded_or_not_published",
        "posting_date_recorded_or_not_published",
        "travel_recorded_or_not_stated",
        "complete_job_description_acquired"
      ]
    },
    {
      "id": "workspace",
      "required": true,
      "checks": [
        "dated_drive_folder_confirmed",
        "job_description_archived",
        "github_package_confirmed",
        "single_notion_record_confirmed"
      ]
    },
    {
      "id": "standards_and_lane",
      "required": true,
      "checks": [
        "current_github_standards_reviewed",
        "resume_scanability_standard_reviewed",
        "primary_lane_selected",
        "fit_score_recorded",
        "gaps_recorded",
        "hiring_manager_concerns_recorded"
      ]
    },
    {
      "id": "evidence",
      "required": true,
      "checks": [
        "verified_evidence_reviewed",
        "candidate_separation_passed",
        "privacy_filter_passed",
        "unsupported_claims_removed",
        "praise_evidence_checked_when_relevant",
        "selected_praise_linked_to_verified_experience",
        "quote_verbatim_status_checked",
        "reviewer_identity_suppressed"
      ]
    },
    {
      "id": "documents",
      "required": true,
      "checks": [
        "resume_markdown_complete",
        "resume_headline_added_or_omission_recorded",
        "summary_scanability_passed",
        "verified_metrics_prioritized",
        "older_experience_compressed_by_relevance",
        "cover_letter_markdown_complete",
        "resume_docx_complete",
        "resume_pdf_complete",
        "cover_letter_docx_complete",
        "cover_letter_pdf_complete"
      ]
    },
    {
      "id": "validation",
      "required": true,
      "checks": [
        "anti_ai_passed",
        "privacy_passed",
        "prohibited_content_passed",
        "factual_consistency_passed",
        "contact_information_passed",
        "education_constants_passed",
        "ats_review_passed",
        "resume_scanability_passed",
        "application_packet_validator_passed",
        "delivery_gate_passed_or_not_applicable"
      ]
    },
    {
      "id": "visual_qa",
      "required": true,
      "checks": [
        "every_pdf_page_rendered",
        "every_pdf_page_visually_inspected",
        "no_clipping_or_overflow",
        "header_and_typography_passed",
        "header_to_first_heading_spacing_passed",
        "major_section_spacing_passed",
        "entry_spacing_passed",
        "cover_letter_paragraph_spacing_passed",
        "visual_rhythm_and_breathing_room_passed",
        "orphan_and_widow_control_passed",
        "links_and_contact_row_passed",
        "no_private_identifiers_visible"
      ]
    },
    {
      "id": "publication",
      "required": true,
      "checks": [
        "final_files_saved_to_drive",
        "validation_report_saved_to_drive",
        "github_metadata_updated",
        "notion_record_updated",
        "cross_system_links_confirmed",
        "public_evidence_citation_gate_passed_or_not_applicable"
      ]
    }
  ],
  "layout_minimums": {
    "units": "twips",
    "twips_per_point": 20,
    "header_to_first_heading": 360,
    "major_section_before": 280,
    "major_section_after": 120,
    "major_entry_before": 160,
    "job_title_after": 40,
    "employer_line_after": 80,
    "body_paragraph_after": 80,
    "bullet_after": 40,
    "cover_letter_paragraph_after": 120,
    "compression_rule": "Edit or remove content before reducing any minimum spacing, body font size, or approved page margin."
  },
  "ready_to_submit_rule": {
    "all_required_checks_must_pass": true,
    "exceptions_must_be_empty": true,
    "submission_requires_user_or_confirmation_evidence": true
  },
  "prohibited_claims": [
    "invented_title",
    "invented_certification",
    "invented_software_proficiency",
    "invented_metric",
    "invented_customer_outcome",
    "invented_enterprise_experience",
    "invented_responsibility",
    "invented_direct_reports",
    "invented_budget_ownership"
  ],
  "prohibited_identifiers": [
    "post_number",
    "badge_number",
    "social_security_number",
    "personnel_identifier",
    "protected_case_number",
    "victim_information",
    "private_address"
  ],
  "rejection_cleanup_rule": {
    "trigger": "troy_confirms_rejection_or_no_thank_you",
    "application_status": "rejected",
    "require_single_matching_application_record": true,
    "prefer_stored_calendar_event_id": true,
    "require_unique_application_identity_and_status_followup_purpose": true,
    "employer_or_title_only_match_prohibited": true,
    "clear_status_followup_next_action": true,
    "delete_related_outlook_application_followups": true,
    "rejection_confirmation_authorizes_matched_status_followup_deletion": true,
    "ambiguous_or_multiple_match_action": "do_not_delete_and_report",
    "duplicate_application_record_action": "do_not_delete_and_report",
    "mixed_purpose_event_action": "preserve",
    "recurring_series_action": "preserve_without_explicit_direction",
    "preserve": [
      "interviews",
      "legal_deadlines",
      "benefits_deadlines",
      "mixed_purpose_events",
      "unrelated_appointments",
      "recurring_series"
    ],
    "require_source_date_when_available": true,
    "allow_user_confirmation_when_message_unavailable": true,
    "verify_record_and_calendar_cleanup": true
  }
}
